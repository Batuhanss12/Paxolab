# FORMA only — never point these at external packaging monorepos.

# --- Frontend (Vite) ---
# VITE_ENGINE=mock
# VITE_FORMA_LLM_KEY=
# VITE_FORMA_LLM_URL=

# --- Local FORMA API (Phase 6+) ---
# FORMA_API_PORT=8787
# PORT=8787

# Public URLs used for iyzico callbacks + CORS allow-list
FORMA_PUBLIC_URL=http://localhost:5173
FORMA_SITE_URL=http://localhost:3000
FORMA_API_PUBLIC_URL=http://localhost:8787

# --- Phase 8 — iyzico sandbox ---
# Leave IYZI_API_KEY / IYZI_SECRET_KEY empty → mock provider (no network, no charges)
IYZI_API_KEY=
IYZI_SECRET_KEY=
IYZI_BASE_URL=https://sandbox-api.iyzipay.com

# --- Phase 9 — first admin ---
# Register with this email (case-insensitive) → role=admin
FORMA_ADMIN_EMAIL=admin@forma.local

# --- Google OAuth (Web client) ---
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth client (Web)
# 2. Authorized JavaScript origins:
#      http://localhost:3000
#      http://localhost:5173
# 3. Authorized redirect URI (must match exactly):
#      http://localhost:8787/api/auth/google/callback
# 4. Paste the client ID/secret below and restart the API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# --- Phase 10 — launch hardening ---
# In-memory per-IP limiter (single process only — not for multi-instance prod)
# FORMA_RATE_LIMIT_DISABLED=1
# FORMA_RATE_LIMIT_AUTH=20
# FORMA_RATE_LIMIT_CHECKOUT=30
# FORMA_MAX_BODY_BYTES=2097152
