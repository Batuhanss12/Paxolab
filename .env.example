# FORMA only — never point these at external packaging monorepos.

# --- Frontend (Vite) ---
# VITE_ENGINE=mock
#
# The model settings used to live here as VITE_FORMA_LLM_URL / _KEY. They no longer
# do, and must not come back: Vite inlines every VITE_-prefixed value into the
# bundle, so a key set here is served to every visitor in readable JavaScript, and
# a self-hosted URL becomes an unauthenticated GPU with the address published.
# They are FORMA_LLM_* below, read by the server only.

# --- Local FORMA API (Phase 6+) ---
# FORMA_API_PORT=8787
# PORT=8787

# --- The three addresses, named three times -------------------------------
# Same three URLs, one set of names per app. All three have to agree or the
# apps talk past each other; only the server's were documented before, so a
# deploy that set FORMA_SITE_URL still shipped a studio linking to localhost.
#
#   what                     server (this file)      site (Next)              studio (Vite)
#   marketing site           FORMA_SITE_URL          NEXT_PUBLIC_SITE_URL     VITE_SITE_URL
#   studio                   FORMA_PUBLIC_URL        NEXT_PUBLIC_STUDIO_URL   — (its own origin)
#   API                      FORMA_API_PUBLIC_URL    NEXT_PUBLIC_API_URL      — (relative /api)
#
# The studio never names the API: it calls relative paths so the request is
# always same-origin. That is what lets this process serve the built studio in
# production without a reverse proxy having to be configured correctly.
# See docs/DEPLOY.md.

# Public URLs used for iyzico callbacks + CORS allow-list
FORMA_PUBLIC_URL=http://localhost:5173
FORMA_SITE_URL=http://localhost:3000
FORMA_API_PUBLIC_URL=http://localhost:8787

# Studio (Vite). Only the site's address is needed — the API is relative.
VITE_SITE_URL=http://localhost:3000

# Site (Next). Set these in site/.env.local, not here.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_STUDIO_URL=http://localhost:5173
# NEXT_PUBLIC_API_URL=http://localhost:8787

# Serve the built studio from the API process. Defaults to ./dist when it
# exists; unset in development, where Vite serves the studio on :5173.
# FORMA_STUDIO_DIST=dist

# --- Phase 8 — iyzico sandbox ---
# Leave IYZI_API_KEY / IYZI_SECRET_KEY empty → mock provider (no network, no charges)
IYZI_API_KEY=
IYZI_SECRET_KEY=
IYZI_BASE_URL=https://sandbox-api.iyzipay.com

# --- Phase 9 — first admin ---
# Register with this email (case-insensitive) → role=admin
FORMA_ADMIN_EMAIL=admin@forma.local

# --- Google OAuth (Web client) ---
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth client (Web)
# 2. Authorized JavaScript origins:
#      http://localhost:3000
#      http://localhost:5173
# 3. Authorized redirect URI (must match exactly):
#      http://localhost:8787/api/auth/google/callback
# 4. Paste the client ID/secret below and restart the API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# --- Phase 10 — launch hardening ---
# In-memory per-IP limiter (single process only — not for multi-instance prod)
# FORMA_RATE_LIMIT_DISABLED=1
# FORMA_RATE_LIMIT_AUTH=20
# FORMA_RATE_LIMIT_CHECKOUT=30
# FORMA_RATE_LIMIT_LLM=60
# FORMA_MAX_BODY_BYTES=2097152

# --- Language model (server-side only — never VITE_) -----------------------
# Unset = the deterministic engine answers everything, which is the default and
# a fully working product. Set FORMA_LLM_URL to hand the writing tasks over.
#
# Any OpenAI-compatible /chat/completions endpoint works, so a self-hosted model
# needs no code change — only the address:
#   Ollama   FORMA_LLM_URL=http://localhost:11434/v1/chat/completions
#            FORMA_LLM_MODEL=qwen2.5:7b-instruct        (no key needed)
#   vLLM     FORMA_LLM_URL=http://localhost:8000/v1/chat/completions
#            FORMA_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#   hosted   FORMA_LLM_URL=https://api.openai.com/v1/chat/completions
#            FORMA_LLM_MODEL=gpt-4o-mini   FORMA_LLM_KEY=sk-...
# FORMA_LLM_URL=
# FORMA_LLM_MODEL=
# FORMA_LLM_KEY=
# FORMA_LLM_MAX_BODY_BYTES=4194304
