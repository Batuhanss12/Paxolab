{
  "name": "forma",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "npm --prefix site run dev",
    "server": "tsx server/index.ts",
    "dev:all": "concurrently -n site,studio,api -c green,cyan,magenta \"npm run dev:site\" \"npm run dev\" \"npm run server\"",
    "build": "tsc -b && vite build",
    "build:site": "npm --prefix site run build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:all": "concurrently -n spa,server -c cyan,magenta --kill-others-on-fail \"vitest run\" \"vitest run --config vitest.server.config.ts\"",
    "smoke:api": "node scripts/smoke-api.mjs",
    "cert:box": "npx --yes vite-node scripts/forma-box-cert.ts",
    "cert:press": "npx --yes vite-node scripts/forma-press-proof.ts",
    "pattern:ingest": "npx --yes vite-node scripts/ingest-art-pattern-library.ts",
    "pattern:mix": "npx --yes vite-node scripts/generate-pattern-mix.ts",
    "pattern:compose": "npx --yes vite-node scripts/generate-pattern-compositions.ts",
    "pattern:blank": "npx --yes vite-node scripts/generate-blank-canvas.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0",
    "iyzipay": "^2.0.69",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
